# Copy to .env.local and fill in. Never commit real values.

# --- Public (exposed to the browser) ---
# Canonical production URL, no trailing slash. Used for canonical tags, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional override of the company name (default "Hormuz-Energy" in src/lib/site.ts).
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_SHORT_NAME=
# Public contact email. Leave empty to hide it. Phone, WhatsApp and address live in src/lib/site.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Server only (enquiry form delivery via Resend, see src/lib/enquiry-delivery.ts) ---
RESEND_API_KEY=
# One or more inboxes, comma-separated, e.g. a@example.com,b@example.com
CONTACT_TO_EMAIL=
# Must be a sender verified with the provider, e.g. "Website <enquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=
