# Copy to .env.local and fill in. Never commit real values.

# --- Public (exposed to the browser) ---
# Canonical production URL, no trailing slash. Used for canonical tags, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional override of the company name (default "Hormuz-Energy" in src/lib/site.ts).
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_SHORT_NAME=
# Public contact email. Leave empty to hide it. Phone, WhatsApp and address live in src/lib/site.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Server only: enquiry form delivery (see src/lib/enquiry-delivery.ts) ---
# One or more inboxes that receive enquiries, comma-separated, e.g. a@example.com,b@example.com
CONTACT_TO_EMAIL=

# Option A (used when set): send through a Gmail account with a Google App Password
# (Google Account > Security > 2-Step Verification on > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Resend (needs a domain verified with Resend). Used when the Gmail variables are empty.
RESEND_API_KEY=
# Sender on the verified domain, e.g. "Website <enquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=
